    // ===== Карта маршруту водія =====
    private ElementReference mapEl;
    private IJSObjectReference? mapModule;
    private bool mapReady, mapDirty = true, mapBusy;
    private int? mapOrderId;
    private bool routeKnown, routeApprox;
    private double routeKm, routeMin;
    private string mapMessage = "";

    private class MapResult
    {
        public List<GeoPoint> Geocoded { get; set; } = new();
        public List<string> Missing { get; set; } = new();
        public double Km { get; set; }
        public double Min { get; set; }
        public bool Approx { get; set; }
        public bool HasRoute { get; set; }
    }

    private class GeoPoint
    {
        public int Id { get; set; }
        public double Lat { get; set; }
        public double Lng { get; set; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Немає замовлення: блок карти не відображається, наступного разу карту треба створити заново
        if (currentOrder == null)
        {
            mapReady = false;
            mapOrderId = null;
            return;
        }

        if (mapBusy || (mapReady && mapOrderId == currentOrder.Id && !mapDirty))
            return;

        mapBusy = true;
        try
        {
            mapModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/driverMap.js");

            if (!mapReady || mapOrderId != currentOrder.Id)
            {
                await mapModule.InvokeVoidAsync("init", mapEl);
                mapReady = true;
                mapOrderId = currentOrder.Id;
                routeKnown = false;
            }

            mapDirty = false;
            await DrawRouteAsync();
        }
        catch (JSDisconnectedException) { }
        catch (Exception ex)
        {
            mapDirty = false;
            mapMessage = "Карту не вдалося завантажити: " + ex.Message;
            StateHasChanged();
        }
        finally
        {
            mapBusy = false;
        }

        // Стан змінився, поки малювався маршрут
        if (mapDirty)
            StateHasChanged();
    }

    // Малює пункти замовлення й маршрут, зберігає знайдені координати та оновлює відстань і час
    private async Task DrawRouteAsync()
    {
        if (mapModule == null || currentOrder == null)
            return;

        var points = OrderService.GetRoutePoints(currentOrder.Id)
            .Select(p => new { id = p.Id, seq = p.Seq, isLoading = p.IsLoading, address = p.Address, status = p.Status, lat = p.Lat, lng = p.Lng })
            .ToList();

        var result = await mapModule.InvokeAsync<MapResult?>("showRoute", points, currentOrder.CompletedPoints);
        if (result == null)
            return;

        foreach (var g in result.Geocoded)
            OrderService.SavePointCoordinates(g.Id, g.Lat, g.Lng);

        routeKnown = result.HasRoute;
        routeApprox = result.Approx;
        routeKm = result.Km;
        routeMin = result.Min;
        mapMessage = result.Missing.Count > 0
            ? "Не знайдено на карті: " + string.Join("; ", result.Missing)
            : "";

        StateHasChanged();
    }

    // Орієнтовний час: не швидше за міську межу 50 км/год (ТЗ); при ожеледиці швидкість менша на 40%
    private int RouteMinutes()
    {
        var minutes = Math.Max(routeMin, routeKm / 50d * 60d);
        if (EmergencyService.CurrentEmergency == "Ожеледиця")
            minutes /= 0.6;
        return (int)Math.Round(minutes);
    }

    private string RouteSummary()
    {
        if (!routeKnown)
            return string.IsNullOrEmpty(mapMessage) ? "Розрахунок маршруту…" : "Маршрут не розраховано";

        var text = $"Відстань: ~{routeKm:0.#} км · Час: ~{RouteMinutes()} хв";
        if (routeApprox)
            text += " (орієнтовно, за прямими лініями)";
        if (EmergencyService.CurrentEmergency == "Ожеледиця")
            text += " · ожеледиця: швидкість зменшено на 40%";
        return text;
    }

    private static async Task DisposeMapAsync(IJSObjectReference module)
    {
        try
        {
            await module.InvokeVoidAsync("dispose");
            await module.DisposeAsync();
        }
        catch { }
    }

    public void Dispose()
    {
        if (mapModule != null)
        {
            var module = mapModule;
            mapModule = null;
            _ = DisposeMapAsync(module);
        }
        EmergencyService.OnChange -= OnEmergencyChanged;
        OrderService.OnChange -= OnOrderChanged;
        ReportService.OnChange -= OnReportChanged;
    }
}